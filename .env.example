# ==============================================================================
# ROUTEVECTOR PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local testing, or add to Vercel Environment Variables.
# DO NOT put real secrets in this example file.
# ==============================================================================

# Supabase Project REST URL (e.g., https://your-project-ref.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon Key (Public client safe)
# Accepts modern publishable format (sb_publishable_...) or legacy anon JWT (eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here

# Supabase Service Role / Secret Key (Server-side ONLY - Keep strictly secret!)
# Required by Next.js API route handlers to record clicks and manage links with RLS
# Accepts modern secret format (sb_secret_...) or legacy service_role JWT (eyJ...)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

